# Public frontend configuration only; never place API/provider secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_DEMO_MODE=true
# Local serve-static may proxy /api and /health when CAUSORA_BACKEND_URL is set. A public frontend must set a public HTTPS API origin or enable static-only mode; never use a visitor-localhost URL.
NEXT_PUBLIC_CAUSORA_API_BASE_URL=
# Set true only for public static-only staging with no API backend. Live API functions are then visibly disabled.
NEXT_PUBLIC_CAUSORA_STATIC_ONLY=false
# Must identify a dataset already available to the backend.
NEXT_PUBLIC_CAUSORA_DATASET_ID=ds-001
# Explicit development-only adapter opt-in. Keep blank for default/fail-closed integration.
NEXT_PUBLIC_CAUSORA_UNREVIEWED_DEV_MODE=
