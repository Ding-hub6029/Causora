        "role": {
          "enum": [
            "CFO",
            "COO",
            "Risk"
          ],
          "title": "Role",
          "type": "string"
        },
        "status": {
          "enum": [
            "Aligned",
            "Watch"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
