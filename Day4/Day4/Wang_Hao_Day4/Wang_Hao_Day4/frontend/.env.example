# Public frontend configuration only; never place API/provider secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_DEMO_MODE=true
# Leave blank for a same-origin /api/simulate reverse proxy, or set the backend origin (for example http://localhost:8000).
NEXT_PUBLIC_CAUSORA_API_BASE_URL=
# Must identify a dataset already available to the backend.
NEXT_PUBLIC_CAUSORA_DATASET_ID=ds-001
# Explicit development-only adapter opt-in. Keep blank for default/fail-closed integration.
NEXT_PUBLIC_CAUSORA_UNREVIEWED_DEV_MODE=
