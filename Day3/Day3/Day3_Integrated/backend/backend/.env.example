# Local CORS allowlist. Do not use * with credentials.
CAUSORA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DEVELOPMENT-ONLY shortcut. Exact value only; do not use in a reviewed/decision environment.
# Preferred entry point: python scripts/start_unreviewed_dev.py --port 8000
# CAUSORA_DEV_UNREVIEWED_MODE=UNREVIEWED_DEV_ONLY

# Wang-owned reviewed contract bundle (reviewed_contract.json + review_record.json).
# CAUSORA_REVIEW_BUNDLE_DIR=/absolute/path/to/wang-reviewed-bundle
# CAUSORA_REVIEW_VERIFIER=app.release_verifiers:verify_reviewed_bundle_record

# Three-owner model policy and separate hash-bound approval record.
# CAUSORA_APPROVED_POLICY_PATH=/absolute/path/to/team_policy.json
# CAUSORA_POLICY_APPROVAL_RECORD_PATH=/absolute/path/to/policy_approval_record.json
# CAUSORA_POLICY_VERIFIER=app.release_verifiers:verify_team_policy_record

# Three-owner release record binding backend/common/TypeScript/frontend v2 artifacts.
# CAUSORA_TRACE_CONTRACT_V2_RELEASE_RECORD=/absolute/path/to/trace_v2_release_record.json
# CAUSORA_COMMON_API_CONTRACT_PATH=/absolute/path/to/API_CONTRACT_V2.md
# CAUSORA_TYPESCRIPT_V2_TYPES_PATH=/absolute/path/to/contracts-v2.ts
# CAUSORA_FRONTEND_V2_VALIDATOR_PATH=/absolute/path/to/simulate-api.ts
# CAUSORA_TRACE_CONTRACT_V2_VERIFIER=app.release_verifiers:verify_trace_contract_release

# Per-run audit artifacts; a writable directory is required for v2 200s.
# CAUSORA_TRACE_ARTIFACT_DIR=/absolute/path/to/trace-artifacts
