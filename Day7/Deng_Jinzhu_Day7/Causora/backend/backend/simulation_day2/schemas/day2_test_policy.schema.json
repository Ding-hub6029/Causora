{
  "additionalProperties": false,
  "properties": {
    "assumptionStatus": {
      "const": "UNAPPROVED_TEST_INPUT",
      "title": "Assumptionstatus",
      "type": "string"
    },
    "horizonStartDate": {
      "format": "date",
      "title": "Horizonstartdate",
      "type": "string"
    },
    "openingInventoryEffectiveDate": {
      "format": "date",
      "title": "Openinginventoryeffectivedate",
      "type": "string"
    },
    "openingInventoryUnits": {
      "minimum": 0,
      "title": "Openinginventoryunits",
      "type": "integer"
    },
    "openingInventorySource": {
      "title": "Openinginventorysource",
      "type": "string"
    },
    "sellingPriceUsdPerUnit": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Sellingpriceusdperunit"
    },
    "lostContributionMarginUsdPerUnit": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Lostcontributionmarginusdperunit"
    },
    "holdingCostUsdPerUnitWeek": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Holdingcostusdperunitweek"
    },
    "safetyStockUnits": {
      "minimum": 0,
      "title": "Safetystockunits",
      "type": "integer"
    },
    "targetStockUnits": {
      "exclusiveMinimum": 0,
      "title": "Targetstockunits",
      "type": "integer"
    },
    "cashTiming": {
      "const": "at_order",
      "title": "Cashtiming",
      "type": "string"
    },
    "roundingMode": {
      "const": "half_even",
      "title": "Roundingmode",
      "type": "string"
    },
    "demandMode": {
      "const": "history_rescaled_to_scenario_units",
      "title": "Demandmode",
      "type": "string"
    },
    "leadTimeMode": {
      "const": "seed_rotated_empirical_cycle",
      "title": "Leadtimemode",
      "type": "string"
    },
    "leadStressAppliesTo": {
      "enum": [
        "A_only",
        "all_suppliers"
      ],
      "title": "Leadstressappliesto",
      "type": "string"
    },
    "commitmentSchedule": {
      "const": "linear_weekly",
      "title": "Commitmentschedule",
      "type": "string"
    },
    "purchaseRecognition": {
      "const": "at_order",
      "title": "Purchaserecognition",
      "type": "string"
    },
    "holdingBasis": {
      "const": "available_ending_average",
      "title": "Holdingbasis",
      "type": "string"
    }
  },
  "required": [
    "assumptionStatus",
    "horizonStartDate",
    "openingInventoryEffectiveDate",
    "openingInventoryUnits",
    "openingInventorySource",
    "sellingPriceUsdPerUnit",
    "lostContributionMarginUsdPerUnit",
    "holdingCostUsdPerUnitWeek",
    "safetyStockUnits",
    "targetStockUnits",
    "cashTiming",
    "roundingMode",
    "demandMode",
    "leadTimeMode",
    "leadStressAppliesTo",
    "commitmentSchedule",
    "purchaseRecognition",
    "holdingBasis"
  ],
  "title": "Day2Policy",
  "type": "object"
}
