        "week": {
          "minimum": 1,
          "title": "Week",
          "type": "integer"
        },
        "startDate": {
          "format": "date",
          "title": "Startdate",
          "type": "string"
        },
        "openingUnits": {
          "minimum": 0,
          "title": "Openingunits",
          "type": "integer"
        },
        "arrivalsA": {
          "minimum": 0,
          "title": "Arrivalsa",
          "type": "integer"
        },
        "arrivalsB": {
          "minimum": 0,
          "title": "Arrivalsb",
          "type": "integer"
        },
        "demandUnits": {
          "minimum": 0,
          "title": "Demandunits",
          "type": "integer"
        },
        "availableUnits": {
          "minimum": 0,
