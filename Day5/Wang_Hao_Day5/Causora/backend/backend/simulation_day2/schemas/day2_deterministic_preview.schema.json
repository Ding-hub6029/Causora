{
  "$defs": {
    "Day2Policy": {
      "additionalProperties": false,
      "properties": {
        "assumptionStatus": {
          "const": "UNAPPROVED_TEST_INPUT",
          "title": "Assumptionstatus",
          "type": "string"
        },
        "horizonStartDate": {
          "format": "date",
          "title": "Horizonstartdate",
          "type": "string"
        },
        "openingInventoryEffectiveDate": {
          "format": "date",
          "title": "Openinginventoryeffectivedate",
          "type": "string"
        },
        "openingInventoryUnits": {
          "minimum": 0,
          "title": "Openinginventoryunits",
          "type": "integer"
        },
        "openingInventorySource": {
          "title": "Openinginventorysource",
          "type": "string"
        },
        "sellingPriceUsdPerUnit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Sellingpriceusdperunit"
        },
        "lostContributionMarginUsdPerUnit": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Lostcontributionmarginusdperunit"
        },
        "holdingCostUsdPerUnitWeek": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Holdingcostusdperunitweek"
        },
        "safetyStockUnits": {
          "minimum": 0,
          "title": "Safetystockunits",
          "type": "integer"
        },
        "targetStockUnits": {
          "exclusiveMinimum": 0,
          "title": "Targetstockunits",
          "type": "integer"
        },
        "cashTiming": {
          "const": "at_order",
          "title": "Cashtiming",
          "type": "string"
        },
        "roundingMode": {
          "const": "half_even",
          "title": "Roundingmode",
          "type": "string"
        },
        "demandMode": {
          "const": "history_rescaled_to_scenario_units",
          "title": "Demandmode",
          "type": "string"
        },
        "leadTimeMode": {
          "const": "seed_rotated_empirical_cycle",
          "title": "Leadtimemode",
          "type": "string"
        },
        "leadStressAppliesTo": {
          "enum": [
            "A_only",
            "all_suppliers"
          ],
          "title": "Leadstressappliesto",
          "type": "string"
        },
        "commitmentSchedule": {
          "const": "linear_weekly",
          "title": "Commitmentschedule",
          "type": "string"
        },
        "purchaseRecognition": {
          "const": "at_order",
          "title": "Purchaserecognition",
          "type": "string"
        },
        "holdingBasis": {
          "const": "available_ending_average",
          "title": "Holdingbasis",
          "type": "string"
        }
      },
      "required": [
        "assumptionStatus",
        "horizonStartDate",
        "openingInventoryEffectiveDate",
        "openingInventoryUnits",
        "openingInventorySource",
        "sellingPriceUsdPerUnit",
        "lostContributionMarginUsdPerUnit",
        "holdingCostUsdPerUnitWeek",
        "safetyStockUnits",
        "targetStockUnits",
        "cashTiming",
        "roundingMode",
        "demandMode",
        "leadTimeMode",
        "leadStressAppliesTo",
        "commitmentSchedule",
        "purchaseRecognition",
        "holdingBasis"
      ],
      "title": "Day2Policy",
      "type": "object"
    },
    "DeterministicCell": {
      "additionalProperties": false,
      "properties": {
        "scenarioId": {
          "enum": [
            "baseline",
            "demand-drop",
            "lead-stress"
          ],
          "title": "Scenarioid",
          "type": "string"
        },
        "optionId": {
          "enum": [
            "D0",
            "D1",
            "D2"
          ],
          "title": "Optionid",
          "type": "string"
        },
        "demandUnits": {
          "minimum": 0,
          "title": "Demandunits",
          "type": "integer"
        },
        "fulfilledUnits": {
          "minimum": 0,
          "title": "Fulfilledunits",
          "type": "integer"
        },
        "lostUnits": {
          "minimum": 0,
          "title": "Lostunits",
          "type": "integer"
        },
        "orderedUnitsA": {
          "minimum": 0,
          "title": "Orderedunitsa",
          "type": "integer"
        },
        "orderedUnitsB": {
          "minimum": 0,
          "title": "Orderedunitsb",
          "type": "integer"
        },
        "deliveredUnitsA": {
          "minimum": 0,
          "title": "Deliveredunitsa",
          "type": "integer"
        },
        "deliveredUnitsB": {
          "minimum": 0,
          "title": "Deliveredunitsb",
          "type": "integer"
        },
        "unitsInTransitAtEnd": {
          "minimum": 0,
          "title": "Unitsintransitatend",
          "type": "integer"
        },
        "endingInventoryUnits": {
          "minimum": 0,
          "title": "Endinginventoryunits",
          "type": "integer"
        },
        "stockoutOccurred": {
          "title": "Stockoutoccurred",
          "type": "boolean"
        },
        "serviceLevel": {
          "maximum": 1,
          "minimum": 0,
          "title": "Servicelevel",
          "type": "number"
        },
        "feasible": {
          "title": "Feasible",
          "type": "boolean"
        },
        "revenueUsd": {
          "title": "Revenueusd",
          "type": "integer"
        },
        "grossProfitUsd": {
          "title": "Grossprofitusd",
          "type": "integer"
        },
        "grossMargin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Grossmargin"
        },
        "grossMarginStatus": {
          "enum": [
            "VALID",
            "INVALID_REVENUE_ZERO"
          ],
          "title": "Grossmarginstatus",
          "type": "string"
        },
        "cashOutflowUsd": {
          "minimum": 0,
          "title": "Cashoutflowusd",
          "type": "integer"
        },
        "costBreakdownUsd": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "purchase",
              "holding",
              "stockoutLoss",
              "renewalPremium",
              "terminationFee"
            ]
          },
          "title": "Costbreakdownusd",
          "type": "object"
        },
        "tcoUsd": {
          "minimum": 0,
          "title": "Tcousd",
          "type": "integer"
        },
        "weeklyTrace": {
          "items": {
            "$ref": "#/$defs/WeekTrace"
          },
          "maxItems": 104,
          "minItems": 104,
          "title": "Weeklytrace",
          "type": "array"
        }
      },
      "required": [
        "scenarioId",
        "optionId",
        "demandUnits",
        "fulfilledUnits",
        "lostUnits",
        "orderedUnitsA",
        "orderedUnitsB",
        "deliveredUnitsA",
        "deliveredUnitsB",
        "unitsInTransitAtEnd",
        "endingInventoryUnits",
        "stockoutOccurred",
        "serviceLevel",
        "feasible",
        "revenueUsd",
        "grossProfitUsd",
        "grossMargin",
        "grossMarginStatus",
        "cashOutflowUsd",
        "costBreakdownUsd",
        "tcoUsd",
        "weeklyTrace"
      ],
      "title": "DeterministicCell",
      "type": "object"
    },
    "WeekTrace": {
      "additionalProperties": false,
