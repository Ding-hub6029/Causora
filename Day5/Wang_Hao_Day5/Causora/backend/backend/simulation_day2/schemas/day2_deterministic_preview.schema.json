          "type": "integer"
        },
        "fulfilledUnits": {
          "minimum": 0,
          "title": "Fulfilledunits",
          "type": "integer"
        },
        "lostUnits": {
          "minimum": 0,
          "title": "Lostunits",
          "type": "integer"
        },
        "endingUnits": {
          "minimum": 0,
          "title": "Endingunits",
          "type": "integer"
        },
        "onOrderUnitsBefore": {
          "minimum": 0,
          "title": "Onorderunitsbefore",
          "type": "integer"
        },
        "inventoryPositionBefore": {
          "minimum": 0,
          "title": "Inventorypositionbefore",
          "type": "integer"
        },
        "reorderPointUnits": {
          "minimum": 0,
          "title": "Reorderpointunits",
          "type": "integer"
        },
        "orderedA": {
          "minimum": 0,
          "title": "Ordereda",
          "type": "integer"
        },
        "orderedB": {
          "minimum": 0,
          "title": "Orderedb",
          "type": "integer"
        },
        "sampledLeadDaysA": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sampledleaddaysa"
        },
        "sampledLeadDaysB": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sampledleaddaysb"
        },
        "plannedArrivalWeekA": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Plannedarrivalweeka"
        },
        "plannedArrivalWeekB": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Plannedarrivalweekb"
        },
        "onOrderUnitsAfter": {
          "minimum": 0,
          "title": "Onorderunitsafter",
          "type": "integer"
        },
        "holdingRawUsd": {
          "title": "Holdingrawusd",
          "type": "string"
        },
        "stockoutLossRawUsd": {
          "title": "Stockoutlossrawusd",
          "type": "string"
        },
        "basePurchaseRawUsd": {
          "title": "Basepurchaserawusd",
          "type": "string"
        },
        "renewalPremiumRawUsd": {
          "title": "Renewalpremiumrawusd",
          "type": "string"
        },
        "terminationFeeRawUsd": {
          "title": "Terminationfeerawusd",
          "type": "string"
        }
      },
      "required": [
        "week",
        "startDate",
        "openingUnits",
        "arrivalsA",
        "arrivalsB",
        "demandUnits",
        "availableUnits",
        "fulfilledUnits",
        "lostUnits",
        "endingUnits",
        "onOrderUnitsBefore",
        "inventoryPositionBefore",
        "reorderPointUnits",
        "orderedA",
        "orderedB",
        "sampledLeadDaysA",
        "sampledLeadDaysB",
        "plannedArrivalWeekA",
        "plannedArrivalWeekB",
        "onOrderUnitsAfter",
        "holdingRawUsd",
        "stockoutLossRawUsd",
        "basePurchaseRawUsd",
        "renewalPremiumRawUsd",
        "terminationFeeRawUsd"
      ],
      "title": "WeekTrace",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "CAUSORA_DAY2_INTERNAL_DETERMINISTIC_PREVIEW_V1",
      "title": "Kind",
      "type": "string"
    },
    "status": {
      "enum": [
        "UNREVIEWED_TEST_ONLY_NO_RECOMMENDATION",
        "REVIEWED_SYNTHETIC_POLICY_UNAPPROVED_NO_RECOMMENDATION"
      ],
      "title": "Status",
      "type": "string"
    },
    "decisionReady": {
      "const": false,
      "title": "Decisionready",
      "type": "boolean"
    },
    "internalSchemaVersion": {
      "const": "jinzhu.deterministic-preview.v1",
      "title": "Internalschemaversion",
      "type": "string"
    },
    "referencedContractVersion": {
      "const": "causora.contract.v1",
      "title": "Referencedcontractversion",
      "type": "string"
    },
    "sourceDataVersion": {
      "title": "Sourcedataversion",
      "type": "string"
    },
    "previewId": {
      "title": "Previewid",
      "type": "string"
    },
    "formulaVersion": {
      "const": "tco-v1",
      "title": "Formulaversion",
      "type": "string"
    },
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "weeks": {
      "const": 104,
      "title": "Weeks",
      "type": "integer"
    },
    "deterministicRuns": {
      "const": 1,
      "title": "Deterministicruns",
      "type": "integer"
    },
    "monteCarloRuns": {
      "const": 0,
      "title": "Montecarloruns",
      "type": "integer"
    },
    "reviewStatus": {
      "enum": [
        "PENDING_HUMAN_REVIEW",
        "SELF_ATTESTED_SYNTHETIC_REVIEW"
      ],
      "title": "Reviewstatus",
      "type": "string"
    },
    "reviewSha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reviewsha256"
    },
    "engineSourceSha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Enginesourcesha256",
      "type": "object"
    },
    "assumptionStatus": {
      "const": "UNAPPROVED_TEST_INPUT",
      "title": "Assumptionstatus",
      "type": "string"
    },
    "note": {
      "title": "Note",
      "type": "string"
    },
    "inputHashesSha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Inputhashessha256",
      "type": "object"
    },
    "intermediateManifestSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Intermediatemanifestsha256",
      "type": "string"
    },
    "unitPricesUsd": {
      "additionalProperties": {
        "type": "number"
      },
      "propertyNames": {
        "enum": [
          "A",
          "B"
        ]
      },
      "title": "Unitpricesusd",
      "type": "object"
    },
    "policy": {
      "$ref": "#/$defs/Day2Policy"
    },
    "matrix": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/DeterministicCell"
        },
        "type": "array"
      },
      "propertyNames": {
        "enum": [
          "baseline",
          "demand-drop",
          "lead-stress"
        ]
      },
      "title": "Matrix",
      "type": "object"
    }
  },
  "required": [
    "kind",
    "status",
    "decisionReady",
    "internalSchemaVersion",
    "referencedContractVersion",
    "sourceDataVersion",
    "previewId",
    "formulaVersion",
    "seed",
    "weeks",
    "deterministicRuns",
    "monteCarloRuns",
    "reviewStatus",
    "reviewSha256",
    "engineSourceSha256",
    "assumptionStatus",
    "note",
    "inputHashesSha256",
    "intermediateManifestSha256",
    "unitPricesUsd",
    "policy",
    "matrix"
  ],
  "title": "DeterministicPreview",
  "type": "object"
}
