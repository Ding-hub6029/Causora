{
  "$defs": {
    "BusinessVariable": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "meaning": {
          "title": "Meaning",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/VariableInput"
          },
          "title": "Inputs",
          "type": "array"
        }
      },
      "required": [
        "key",
        "name",
        "value",
        "unit",
        "source",
        "meaning",
        "inputs"
      ],
      "title": "BusinessVariable",
      "type": "object"
    },
    "ContractConstraint": {
      "additionalProperties": false,
      "properties": {
        "decisionDate": {
          "format": "date",
          "title": "Decisiondate",
          "type": "string"
        },
        "renewalDate": {
          "format": "date",
          "title": "Renewaldate",
          "type": "string"
        },
        "daysToRenewal": {
          "minimum": 0,
          "title": "Daystorenewal",
          "type": "integer"
        },
        "renewalNoticeDays": {
          "minimum": 0,
          "title": "Renewalnoticedays",
          "type": "integer"
        },
        "noticeDeadline": {
          "format": "date",
          "title": "Noticedeadline",
          "type": "string"
        },
        "noticeSent": {
          "title": "Noticesent",
          "type": "boolean"
        },
        "noticeRecordSource": {
          "title": "Noticerecordsource",
          "type": "string"
        },
        "renewalLocked": {
          "title": "Renewallocked",
          "type": "boolean"
        },
        "renewalTermMonths": {
          "minimum": 0,
          "title": "Renewaltermmonths",
          "type": "integer"
        },
        "renewalPriceIncreasePct": {
          "maximum": 1,
          "minimum": 0,
          "title": "Renewalpriceincreasepct",
          "type": "number"
        },
        "minPurchaseShareA": {
          "maximum": 1,
          "minimum": 0,
          "title": "Minpurchasesharea",
          "type": "number"
        },
        "forecastBasis": {
          "enum": [
            "locked-at-renewal",
            "rolling"
          ],
          "title": "Forecastbasis",
          "type": "string"
        },
        "lockedForecastUnits24m": {
          "minimum": 0,
          "title": "Lockedforecastunits24M",
          "type": "integer"
        },
        "minPurchaseUnitsA": {
          "minimum": 0,
          "title": "Minpurchaseunitsa",
          "type": "integer"
        },
        "terminationFeeUsd": {
          "minimum": 0,
          "title": "Terminationfeeusd",
          "type": "integer"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "title": "Evidenceids",
          "type": "array"
        }
      },
      "required": [
        "decisionDate",
        "renewalDate",
        "daysToRenewal",
        "renewalNoticeDays",
        "noticeDeadline",
        "noticeSent",
        "noticeRecordSource",
        "renewalLocked",
        "renewalTermMonths",
        "renewalPriceIncreasePct",
        "minPurchaseShareA",
        "forecastBasis",
        "lockedForecastUnits24m",
        "minPurchaseUnitsA",
        "terminationFeeUsd",
        "evidenceIds"
      ],
      "title": "ContractConstraint",
      "type": "object"
    },
    "DatasetResult": {
      "additionalProperties": false,
      "properties": {
        "datasetId": {
          "title": "Datasetid",
          "type": "string"
        },
        "preprocessStatus": {
          "const": "ready",
          "title": "Preprocessstatus",
          "type": "string"
        },
        "dataVersion": {
          "title": "Dataversion",
          "type": "string"
        },
        "intake": {
          "items": {
            "$ref": "#/$defs/IntakeFile"
          },
          "title": "Intake",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRecord"
          },
          "title": "Evidence",
          "type": "array"
        },
        "contract": {
          "$ref": "#/$defs/ContractConstraint"
        },
        "variables": {
          "items": {
            "$ref": "#/$defs/BusinessVariable"
          },
          "title": "Variables",
          "type": "array"
        }
      },
      "required": [
        "datasetId",
        "preprocessStatus",
        "dataVersion",
        "intake",
        "evidence",
        "contract",
        "variables"
      ],
      "title": "DatasetResult",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sourceFile": {
          "title": "Sourcefile",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "locatorBbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Locatorbbox"
        },
        "extractedField": {
          "title": "Extractedfield",
          "type": "string"
        },
        "extractedValue": {
          "title": "Extractedvalue",
          "type": "string"
        },
        "matchMethod": {
          "enum": [
            "exact",
            "fuzzy"
          ],
          "title": "Matchmethod",
          "type": "string"
        },
        "matchScore": {
          "maximum": 1,
          "minimum": 0,
          "title": "Matchscore",
          "type": "number"
        },
        "quoteMatched": {
          "title": "Quotematched",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "sourceFile",
        "page",
        "quote",
        "locatorBbox",
        "extractedField",
        "extractedValue",
        "matchMethod",
        "matchScore",
        "quoteMatched"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "IntakeFile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "size": {
          "title": "Size",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "icon": {
          "title": "Icon",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "type",
        "detail",
        "size",
        "status",
        "icon",
        "path"
      ],
      "title": "IntakeFile",
      "type": "object"
    },
    "VariableInput": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "source"
      ],
      "title": "VariableInput",
      "type": "object"
    }
