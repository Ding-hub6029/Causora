{
  "$defs": {
    "AgentOutput": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "CFO",
            "COO",
            "Risk"
          ],
          "title": "Role",
          "type": "string"
        },
        "narrative_key": {
          "title": "Narrative Key",
          "type": "string"
        },
        "reason_text": {
          "title": "Reason Text",
          "type": "string"
        },
        "option_ids": {
          "items": {
            "enum": [
              "D0",
              "D1",
              "D2"
            ],
            "type": "string"
          },
          "title": "Option Ids",
          "type": "array"
        },
        "metric_refs": {
          "items": {
            "type": "string"
          },
          "title": "Metric Refs",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "MOCK",
            "LIVE",
            "UNAVAILABLE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "role",
        "narrative_key",
        "reason_text",
        "option_ids",
        "metric_refs",
        "evidence_ids",
        "status"
      ],
      "title": "AgentOutput",
      "type": "object"
    },
    "BusinessVariable": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/EvidenceField"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "days",
            "months",
            "fraction",
            "share",
            "USD",
            "boolean"
          ],
          "title": "Unit",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^EV-[0-9]{3}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "quote_matched": {
          "const": true,
          "title": "Quote Matched",
          "type": "boolean"
        },
        "manually_verified": {
          "const": true,
          "title": "Manually Verified",
          "type": "boolean"
        },
        "source": {
          "const": "synthetic_contract",
          "default": "synthetic_contract",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "evidence_id",
        "quote_matched",
        "manually_verified"
      ],
      "title": "BusinessVariable",
      "type": "object"
    },
    "CriticIssue": {
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "pattern": "^CR-[0-9]{3}$",
          "title": "Issue Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "omission",
            "conflict",
            "compound_risk"
          ],
          "title": "Category",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "agent_refs": {
          "items": {
            "enum": [
              "CFO",
              "COO",
              "Risk"
            ],
            "type": "string"
          },
          "title": "Agent Refs",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "metric_refs": {
          "items": {
            "type": "string"
          },
          "title": "Metric Refs",
          "type": "array"
        },
        "status": {
          "enum": [
            "MOCK",
            "LIVE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "category",
        "explanation",
        "agent_refs",
        "evidence_ids",
        "metric_refs",
        "status"
      ],
      "title": "CriticIssue",
      "type": "object"
    },
    "DecisionBriefRef": {
      "additionalProperties": false,
      "properties": {
        "recommended_option_id": {
          "anyOf": [
            {
              "enum": [
                "D0",
                "D1",
                "D2"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recommended Option Id"
        },
        "reason_text": {
          "title": "Reason Text",
          "type": "string"
        },
        "metric_refs": {
          "items": {
            "type": "string"
          },
          "title": "Metric Refs",
          "type": "array"
        },
        "critic_issue_ids": {
          "items": {
            "type": "string"
          },
          "title": "Critic Issue Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "MOCK",
            "LIVE",
            "UNAVAILABLE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "recommended_option_id",
        "reason_text",
        "metric_refs",
        "critic_issue_ids",
        "status"
      ],
      "title": "DecisionBriefRef",
      "type": "object"
    },
    "DecisionOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "D0",
            "D1",
            "D2"
          ],
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "allocation_A": {
          "maximum": 1,
          "minimum": 0,
          "title": "Allocation A",
          "type": "number"
        },
        "allocation_B": {
          "maximum": 1,
          "minimum": 0,
          "title": "Allocation B",
          "type": "number"
        },
        "terminate_A": {
          "title": "Terminate A",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "allocation_A",
        "allocation_B",
        "terminate_A"
      ],
      "title": "DecisionOption",
      "type": "object"
    },
    "EvidenceField": {
      "enum": [
        "renewal_notice_days",
        "auto_renew",
        "renewal_term_months",
        "renewal_price_increase_pct",
        "min_purchase_share_A",
        "termination_fee"
      ],
      "title": "EvidenceField",
      "type": "string"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^EV-[0-9]{3}$",
          "title": "Id",
          "type": "string"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "quote": {
          "minLength": 5,
          "title": "Quote",
          "type": "string"
        },
        "source_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Quote"
        },
        "source_span": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Span"
        },
        "locator_bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator Bbox"
        },
        "extracted_field": {
          "$ref": "#/$defs/EvidenceField"
        },
        "extracted_value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Extracted Value"
        },
        "unit": {
          "enum": [
            "days",
            "months",
            "percent",
            "share",
            "USD",
            "boolean"
          ],
          "title": "Unit",
          "type": "string"
        },
        "match_method": {
          "enum": [
            "exact",
            "fuzzy",
            "none"
          ],
          "title": "Match Method",
          "type": "string"
        },
        "match_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Match Score",
          "type": "number"
        },
        "quote_matched": {
          "title": "Quote Matched",
          "type": "boolean"
        },
        "manually_verified": {
          "default": false,
          "title": "Manually Verified",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "source_file",
        "source_sha256",
        "page",
        "quote",
        "extracted_field",
        "extracted_value",
        "unit",
        "match_method",
        "match_score",
        "quote_matched"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "EvidenceSummary": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/EvidenceRecord"
          },
          "title": "Records",
          "type": "array"
        },
        "business_variables": {
          "items": {
            "$ref": "#/$defs/BusinessVariable"
          },
          "title": "Business Variables",
          "type": "array"
        },
        "scenario_assumptions": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Scenario Assumptions",
          "type": "object"
        },
        "status": {
          "enum": [
            "MOCK_QUOTE_MATCHED_SYNTHETIC",
            "LIVE_VERIFIED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "source_file",
        "records",
        "business_variables",
        "scenario_assumptions",
        "status"
      ],
      "title": "EvidenceSummary",
      "type": "object"
    },
    "PendingMatrixCell": {
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "enum": [
            "D0",
            "D1",
            "D2"
          ],
          "title": "Option Id",
          "type": "string"
        },
        "scenario_id": {
          "enum": [
            "baseline",
            "demand-drop",
            "lead-stress"
          ],
          "title": "Scenario Id",
          "type": "string"
        },
        "status": {
          "const": "AWAITING_SIMULATION",
          "default": "AWAITING_SIMULATION",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "scenario_id"
      ],
      "title": "PendingMatrixCell",
      "type": "object"
    },
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "baseline",
            "demand-drop",
            "lead-stress"
          ],
          "title": "Id",
          "type": "string"
        },
        "demand_multiplier": {
          "exclusiveMinimum": 0,
          "title": "Demand Multiplier",
          "type": "number"
        },
        "supplier_a_lead_time_multiplier": {
          "exclusiveMinimum": 0,
          "title": "Supplier A Lead Time Multiplier",
          "type": "number"
        }
      },
      "required": [
        "id",
        "demand_multiplier",
        "supplier_a_lead_time_multiplier"
      ],
      "title": "Scenario",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "fixture_only": {
      "const": true,
      "default": true,
      "title": "Fixture Only",
      "type": "boolean"
    },
    "display_label": {
      "const": "DAY 1 MOCK \u00b7 NOT A SIMULATION",
      "default": "DAY 1 MOCK \u00b7 NOT A SIMULATION",
      "title": "Display Label",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/EvidenceSummary"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/Scenario"
      },
      "title": "Scenarios",
      "type": "array"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/DecisionOption"
      },
      "title": "Options",
      "type": "array"
    },
    "matrix": {
      "items": {
        "$ref": "#/$defs/PendingMatrixCell"
      },
      "title": "Matrix",
      "type": "array"
    },
    "agents": {
      "items": {
        "$ref": "#/$defs/AgentOutput"
      },
      "title": "Agents",
      "type": "array"
    },
    "critic_issues": {
      "items": {
        "$ref": "#/$defs/CriticIssue"
      },
      "title": "Critic Issues",
      "type": "array"
    },
    "brief": {
      "$ref": "#/$defs/DecisionBriefRef"
    }
  },
  "required": [
    "evidence",
    "scenarios",
    "options",
    "matrix",
    "agents",
    "critic_issues",
    "brief"
  ],
  "title": "MockE2EPayload",
  "type": "object"
}
